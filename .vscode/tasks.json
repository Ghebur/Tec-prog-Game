{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Jogo SFML",
            "command": "g++ -g (Get-ChildItem -Recurse -Filter *.cpp | Select-Object -ExpandProperty FullName) -o ${workspaceFolder}/meu_jogo.exe -I${workspaceFolder}/include -L${workspaceFolder}/lib -lsfml-graphics -lsfml-window -lsfml-system -lsfml-audio",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-Command"]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}